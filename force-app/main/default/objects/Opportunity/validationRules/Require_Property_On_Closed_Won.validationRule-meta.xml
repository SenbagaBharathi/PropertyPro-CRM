<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Property_On_Closed_Won</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(StageName, &quot;Closed Won&quot;), ISBLANK(Property__c))</errorConditionFormula>
    <errorDisplayField>Property__c</errorDisplayField>
    <errorMessage>There is no property linked with this opportunity</errorMessage>
</ValidationRule>
